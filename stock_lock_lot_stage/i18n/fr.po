#. module: stock_lock_lot_stage
#. odoo-python
#: code:addons/stock_lock_lot_stage/models/stock_lot.py:0
#, python-format
msgid ""
"Lots in stage '%(stage)s' must have a partial approved quantity set. Please "
"set a partial approved quantity or move the lot to a different stage."
msgstr ""
"Les lots dans l'étape '%(stage)s' doivent avoir une quantité partiellement "
"approuvée définie. Veuillez définir une quantité partiellement approuvée ou "
"déplacer le lot vers une autre étape."

#. module: stock_lock_lot_stage
#: model:ir.model.fields,help:stock_lock_lot_stage.field_stock_lot__partial_approved_qty
msgid ""
"Maximum quantity allowed in locations that don't allow locked lots.Leave "
"zero to approve the full quantity."
msgstr ""
"Quantité approuvée lorsqu'elle est inférieure à la quantité totale du lot. "
"Laisser zéro pour approuver la quantité totale."

#. module: stock_lock_lot_stage
