<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="stock_lot_stage_view_tree" model="ir.ui.view">
        <field name="name">stock.lot.stage.tree</field>
        <field name="model">stock.lot.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="locked" />
                <field name="allow_partial_approved" />
            </tree>
        </field>
    </record>

    <record id="stock_lot_stage_view_form" model="ir.ui.view">
        <field name="name">stock.lot.stage.form</field>
        <field name="model">stock.lot.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                        <field name="locked" />
                        <field name="allow_partial_approved" invisible="locked" />
                        <field name="fold" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="stock_lot_stage_action" model="ir.actions.act_window">
        <field name="name">Lot Stages</field>
        <field name="res_model">stock.lot.stage</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_stock_lot_stage"
        name="Lot Stages"
        parent="stock.menu_warehouse_config"
        action="stock_lot_stage_action"
        sequence="50"
    />

</odoo>
